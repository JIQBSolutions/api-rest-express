# Puerto local. Render asigna PORT automáticamente.
PORT=3000
NODE_ENV=development

# Para Supabase usa Connect > Session pooler (puerto 5432).
# Sustituye PROJECT_REF, CONTRASENA y REGION; no publiques el valor real.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true

# Alternativa temporal para ejecutar sin PostgreSQL durante el desarrollo local.
# Nunca debe activarse en producción porque los datos no serían persistentes.
USE_IN_MEMORY_DB=false
