# Puerto local. Render asigna PORT automáticamente.
PORT=3000
NODE_ENV=development

# Sustituye usuario, contraseña, host y base con tus datos.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/tareas
DB_SSL=false

# Alternativa temporal para ejecutar sin PostgreSQL durante el desarrollo local.
# Nunca debe activarse en producción porque los datos no serían persistentes.
USE_IN_MEMORY_DB=false
